# =============================================================================
# JOHNTRAN-JS Bot - Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# Zalo Bot Configuration
# -----------------------------------------------------------------------------
# Bot display name shown in Zalo
BOT_NAME=JohnTran Bot

# Command prefix for bot commands (e.g., !help, /help)
PREFIX=!

# Zalo user ID(s) with admin privileges (comma-separated for multiple)
ADMIN_BOT=1234567890

# Zalo user ID for support contact
SUPPORT_BOT=0987654321

# Enable the web admin panel (set true only after configuring a strong token)
JT_PANEL__ENABLED=false
JT_PANEL__HOST=0.0.0.0
JT_PANEL__PORT=3000

# Required when Panel listens on a public interface. Generate with: openssl rand -hex 32
JT_PANEL__TOKEN=

# Optional separate secret for the localhost Panel <-> bot bridge. If omitted, it is generated at runtime.
JT_BRIDGE_TOKEN=

# -----------------------------------------------------------------------------
# Database Configuration (Supabase)
# -----------------------------------------------------------------------------
# Supabase project URL (from Supabase dashboard > Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (from Supabase dashboard > Settings > API)
# WARNING: This key has full admin access - keep it secret!
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Database driver: "json" (file-based) or "supabase" (cloud)
JT_DB_DRIVER=supabase

# JSON database file path (only used when JT_DB_DRIVER=json)
JT_DB_FILE=./data/database.json

# -----------------------------------------------------------------------------
# Cloudflare R2 (Media Cache Storage)
# -----------------------------------------------------------------------------
# Cloudflare Account ID (from R2 dashboard)
R2_ACCOUNT_ID=your-account-id

# R2 Access Key ID (from R2 API tokens)
R2_ACCESS_KEY_ID=your-access-key-id

# R2 Secret Access Key (from R2 API tokens)
R2_SECRET_ACCESS_KEY=your-secret-access-key

# R2 Bucket name for media storage
R2_BUCKET_NAME=johntran-media

# Public URL for R2 bucket (custom domain or *.r2.dev)
# Example: https://media.yourdomain.com or https://bucket.account.r2.dev
R2_PUBLIC_URL=https://your-bucket.your-account.r2.dev

# Cache TTL in seconds for different media types
MEDIA_CACHE_TTL_STICKER=86400    # seconds (1 day)
MEDIA_CACHE_TTL_IMAGE=604800      # seconds (7 days)
MEDIA_CACHE_TTL_AUDIO=259200      # seconds (3 days)
MEDIA_CACHE_TTL_VIDEO=86400       # seconds (1 day)

# -----------------------------------------------------------------------------
# External API Credentials (Optional)
# -----------------------------------------------------------------------------
# SoundCloud Client ID for music features
# Get from: https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=

# TikTok cookies in Netscape format for video downloads
# Export from browser extension (EditThisCookie, etc.)
TIKTOK_COOKIES=

# Custom yt-dlp binary path (if not in PATH)
YTDLP_PATH=

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
# Prometheus push gateway endpoint for metrics (optional)
PROMETHEUS_ENDPOINT=

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Performance & Runtime
# -----------------------------------------------------------------------------
# Node environment
NODE_ENV=production

# Panel child process count (0 = auto based on CPU cores)
JT_PANEL_CHILD=0

# Bridge server port for inter-process communication
JT_BRIDGE_PORT=3001

# Bridge authentication token (generate a strong random string)
JT_BRIDGE_TOKEN=your-bridge-token-here

# -----------------------------------------------------------------------------
# Media Cookies (for downloading protected content)
# -----------------------------------------------------------------------------
# Cookies in Netscape format (raw content)
# Used for YouTube, Facebook, Instagram, etc. that require authentication
JT_MEDIA_COOKIES_CONTENT=

# Path to cookies file (alternative to JT_MEDIA_COOKIES_CONTENT)
# File should be in Netscape format
JT_MEDIA_COOKIES_FILE=./cookies.txt

# =============================================================================
# Notes:
# - All variables marked as "optional" can be left empty
# - Generate secure tokens with: openssl rand -hex 32
# - For Supabase, use the Service Role key (not anon key)
# - R2_PUBLIC_URL should be accessible by end users
# - Cookies must be in Netscape format (tab-separated)
# =============================================================================
