# =============================================================================
# JOHNTRAN-JS Bot - Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# Zalo Bot Configuration
# -----------------------------------------------------------------------------
# Bot display name shown in Zalo
BOT_NAME=JohnTran Bot

# Command prefix for bot commands (e.g., !help, /help)
PREFIX=!

# Zalo user ID(s) with admin privileges (comma-separated for multiple)
ADMIN_BOT=1234567890

# Zalo user ID for support contact
SUPPORT_BOT=0987654321

# Enable the web admin panel (set true only after configuring a strong token)
JT_PANEL__ENABLED=false
JT_PANEL__HOST=0.0.0.0
JT_PANEL__PORT=3000

# Required when Panel listens on a public interface. Generate with: openssl rand -hex 32
JT_PANEL__TOKEN=

# Optional separate secret for the localhost Panel <-> bot bridge. If omitted, it is generated at runtime.
JT_BRIDGE_TOKEN=

# -----------------------------------------------------------------------------
# Local data storage (default; no network database required)
# -----------------------------------------------------------------------------
# The bot stores user/group settings and command data in data/store.json.
# Keep the data/ directory when updating or restarting the bot.
JT_DB_DRIVER=json
JT_DB_FILE=
# Optional persistent directory for VPS/hosted platforms with ephemeral disks.
# When configured, the store is written to $JT_PERSISTENT_DIR/store.json.
# JT_PERSISTENT_DIR=/var/lib/johntran

# Optional legacy remote storage. Leave disabled for the local JSON store.
# To explicitly opt in, set JT_DB_DRIVER=supabase and provide both credentials:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 (Media Cache Storage)
# -----------------------------------------------------------------------------
# Cloudflare Account ID (from R2 dashboard)
R2_ACCOUNT_ID=your-account-id

# R2 Access Key ID (from R2 API tokens)
R2_ACCESS_KEY_ID=your-access-key-id

# R2 Secret Access Key (from R2 API tokens)
R2_SECRET_ACCESS_KEY=your-secret-access-key

# R2 Bucket name for media storage
R2_BUCKET_NAME=johntran-media

# Public URL for R2 bucket (custom domain or *.r2.dev)
# Example: https://media.yourdomain.com or https://bucket.account.r2.dev
R2_PUBLIC_URL=https://your-bucket.your-account.r2.dev

# Cache TTL in seconds for different media types
# Values below are seconds (not milliseconds). Defaults: sticker 1d, image 7d, audio 3d, video 1d.
MEDIA_CACHE_TTL_STICKER=86400
MEDIA_CACHE_TTL_IMAGE=604800
MEDIA_CACHE_TTL_AUDIO=259200
MEDIA_CACHE_TTL_VIDEO=86400

# -----------------------------------------------------------------------------
# External API Credentials (Optional)
# -----------------------------------------------------------------------------
# SoundCloud Client ID for music features
# Get from: https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=

# TikTok cookies in Netscape format for video downloads
# Export from browser extension (EditThisCookie, etc.)
TIKTOK_COOKIES=

# Custom yt-dlp binary path (if not in PATH)
YTDLP_PATH=

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
# Prometheus push gateway endpoint for metrics (optional)
PROMETHEUS_ENDPOINT=

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Performance & Runtime
# -----------------------------------------------------------------------------
# Node environment
NODE_ENV=production

# Panel child process count (0 = auto based on CPU cores)
JT_PANEL_CHILD=0

# Bridge server port for inter-process communication
JT_BRIDGE_PORT=3001

# Bridge authentication token (generate a strong random string)
JT_BRIDGE_TOKEN=

# Speed Engine backpressure (optional; defaults shown)
# Shared active task ceiling for CPU-heavy queue lanes. By default it is
# CPU-aware: 1 job on <=2 available CPUs, then one fewer than CPU count,
# capped at 4. Leave unset unless you have measured CPU headroom.
# JT_JOB_GLOBAL_CONCURRENCY=2

# Number of large media downloads running at once.
# Defaults to CPU-aware: 1 job on hosts with <=2 available CPUs, otherwise 2.
# Keep at 1 on small hosts; only raise after checking /speed and CPU headroom.
# JT_DOWNLOAD_CONCURRENCY=1

# Number of concurrent Discord STK rendering jobs. CPU-aware default is the
# same as JT_DOWNLOAD_CONCURRENCY. Optional override:
# JT_STICKER_CONCURRENCY=1

# FFmpeg encoder/filter threads per media job (1-4). Default: 1, leaving CPU
# headroom for Zalo WebSocket and command replies. Raise only on larger hosts.
JT_FFMPEG_THREADS=1

# Maximum waiting jobs across all queue lanes
JT_JOB_GLOBAL_MAX_PENDING=80

# Maximum waiting jobs per worker pool (canvas/audio/sticker/video)
JT_WORKER_MAX_PENDING=32

# Worker circuit: a 6th crash inside the 60s rolling window opens a 60s+ pause
JT_WORKER_MAX_RESTARTS=5
JT_WORKER_RESTART_WINDOW_MS=60000
JT_WORKER_RESTART_DELAY_MS=1000
JT_WORKER_RESTART_MAX_DELAY_MS=30000
JT_WORKER_CIRCUIT_COOLDOWN_MS=60000

# Zalo listener reconnect: exponential backoff with jitter, capped at 60s
JT_LISTENER_RECONNECT_BASE_MS=5000
JT_LISTENER_RECONNECT_MAX_MS=60000
JT_LISTENER_RECONNECT_JITTER=0.15

# Recovery dashboard warning thresholds (monitoring only; no process kill)
JT_RECOVERY_LOOP_RESOLUTION_MS=20
JT_RECOVERY_LOOP_WARN_MS=250
JT_RECOVERY_LOOP_CRITICAL_MS=1000
JT_RECOVERY_RSS_WARN_RATIO=0.8
JT_RECOVERY_RSS_CRITICAL_RATIO=0.92
JT_RECOVERY_CPU_WARN_PERCENT=85
JT_RECOVERY_QUEUE_WARN_RATIO=0.75

# -----------------------------------------------------------------------------
# Media Cookies (for downloading protected content)
# -----------------------------------------------------------------------------
# Cookies in Netscape format (raw content)
# Used for YouTube, Facebook, Instagram, etc. that require authentication
JT_MEDIA_COOKIES_CONTENT=

# Path to cookies file (alternative to JT_MEDIA_COOKIES_CONTENT)
# File should be in Netscape format
JT_MEDIA_COOKIES_FILE=./cookies.txt

# =============================================================================
# Notes:
# - All variables marked as "optional" can be left empty
# - Generate secure tokens with: openssl rand -hex 32
# - R2_PUBLIC_URL should be accessible by end users
# - Cookies must be in Netscape format (tab-separated)
# =============================================================================

# Tùy chọn: bật AI quét ảnh khỏa thân (omni-moderation-latest)
OPENAI_API_KEY=
# Ngưỡng điểm sexual, mặc định 0.90 (0.50–0.99)
JT_ANTINUDE_SEXUAL_THRESHOLD=0.90
