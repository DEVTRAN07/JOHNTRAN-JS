FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --only=production --ignore-scripts

COPY . .

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache     tini     curl     && addgroup -g 1000 -S nodejs     && adduser -S nodejs -u 1000

COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/package*.json ./
COPY --from=builder --chown=nodejs:nodejs /app/index.js ./
COPY --from=builder --chown=nodejs:nodejs /app/config.yml ./
COPY --from=builder --chown=nodejs:nodejs /app/core ./core
COPY --from=builder --chown=nodejs:nodejs /app/plugins ./plugins
COPY --from=builder --chown=nodejs:nodejs /app/bots ./bots
COPY --from=builder --chown=nodejs:nodejs /app/scripts ./scripts
COPY --from=builder --chown=nodejs:nodejs /app/utils ./utils
COPY --from=builder --chown=nodejs:nodejs /app/data ./data

USER nodejs

ENV NODE_ENV=production     PORT=3000     REGION=unknown

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3     CMD curl -f http://localhost:3000/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["node", "index.js"]