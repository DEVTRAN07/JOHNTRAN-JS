{
  "name": "john_tran_bot",
  "version": "4.0.0",
  "description": "Chatbot Zalo Node.js dựa trên Zalo-Client.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "tsc",
    "start:prod": "NODE_ENV=production node index.js",
    "test": "node --test tests/*.test.js",
    "monitor:memory": "node -e \"setInterval(() => { const mem = process.memoryUsage(); console.log(new Date().toISOString(), 'RSS:', (mem.rss / 1024 / 1024).toFixed(2), 'MB', 'Heap used:', (mem.heapUsed / 1024 / 1024).toFixed(2), 'MB', 'Heap total:', (mem.heapTotal / 1024 / 1024).toFixed(2), 'MB', 'External:', (mem.external / 1024 / 1024).toFixed(2), 'MB'); }, 30000);\"",
    "build:native": "node native/build.js",
    "tui": "node tui.js"
  },
  "keywords": [
    "zalo",
    "chatbot",
    "nodejs",
    "john-tran-bot"
  ],
  "author": "John Tran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DEVTRAN07/JOHNTRAN-JS.git"
  },
  "bugs": {
    "url": "https://github.com/DEVTRAN07/JOHNTRAN-JS/issues"
  },
  "homepage": "https://github.com/DEVTRAN07/JOHNTRAN-JS#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "axios": "^1.11.0",
    "canvas": "^3.1.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^0.16.1",
    "jsqr": "^1.4.0",
    "luxon": "^3.7.1",
    "moment-timezone": "^0.6.0",
    "node-schedule": "^2.1.1",
    "prom-client": "^15.1.0",
    "qrcode": "^1.5.4",
    "semver": "^7.7.2",
    "string-similarity": "^4.0.4",
    "yaml": "^2.8.0",
    "zalo-client": "file:vendor/zalo-client"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.5.12",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
