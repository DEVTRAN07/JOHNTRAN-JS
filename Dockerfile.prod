FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
COPY vendor ./vendor
RUN npm ci --omit=dev
COPY . .

ENV NODE_ENV=production
ENV TZ=Asia/Ho_Chi_Minh
ENV PORT=8000
EXPOSE 8000

CMD ["node", "index.js"]
